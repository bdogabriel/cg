CMD(none,             "none",             "no active command",                              nullptr,            do_none)
CMD(prompt,           "prompt",           "open the command prompt",                        nullptr,            do_prompt)
CMD(execute,          "execute",          "execute the typed command",                      nullptr,            do_execute)
CMD(set_cmd,          "set_cmd",          "switch current command",                         params_set_cmd,     do_set_cmd)
CMD(set_args,         "set_args",         "set axis and step for the active transform",     params_axis_step,   do_set_args)
CMD(set_target,       "set_target",       "switch between object and face target",          params_set_target,  do_set_target)
CMD(toggle_lock,      "toggle_lock",      "toggle local/world transform lock",              nullptr,            do_toggle_lock)
CMD(set_color,        "set_color",        "set color of selected object/face",              params_set_color,   do_set_color)
CMD(set_bg_color,     "set_bg_color",     "set the background color",                       params_set_color,   do_set_bg_color)
CMD(apply_color,      "apply_color",      "apply current color to selected object/face",    nullptr,            do_apply_color)
CMD(toggle_selection, "toggle_selection", "toggle selection of the active face",            nullptr,            do_toggle_selection)
CMD(clear_selection,  "clear_selection",  "clear all selected faces",                       nullptr,            do_clear_selection)
CMD(wireframe_toggle, "wireframe_toggle", "toggle wireframe rendering",                     nullptr,            do_wireframe_toggle)
CMD(cycle,            "cycle",            "cycle next/prev through objects or faces",       params_cycle,       do_cycle)
CMD(reset,            "reset",            "reset rotation or translation of selected object", params_reset,     do_reset)
CMD(undo,             "undo",             "undo the last mutating command",                 nullptr,            do_undo)
CMD(quit,             "quit",             "exit the application",                           nullptr,            do_quit)
CMD(translate,        "translate",        "translate by signed step on axis",               params_axis_step,   do_translate)
CMD(rotate,           "rotate",           "rotate by signed step around axis",              params_axis_step,   do_rotate)
CMD(scale,            "scale",            "scale by signed step on axis",                   params_axis_step,   do_scale)
CMD(shear,            "shear",            "shear by signed step on axis",                   params_axis_step,   do_shear)
CMD(extrude,          "extrude",          "extrude selected faces (one-shot)",              nullptr,            do_extrude)
CMD(del,              "delete",           "delete the selected object (one-shot)",          nullptr,            do_del)
CMD(merge,            "merge",            "merge selected object with the next one (one-shot)", nullptr,        do_merge)
CMD(merge_coplanar,   "merge_coplanar",   "merge coplanar faces of the selected object",    params_merge_coplanar, do_merge_coplanar)
CMD(add_shape,        "add_shape",        "add a primitive shape to the scene",             params_add_shape,   do_add_shape)
CMD(save_obj,         "save_obj",         "save selected object to an .obj file",           params_save_obj,    do_save_obj)
CMD(save,             "save",             "save the scene to a file",                       params_save,        do_save)
CMD(load,             "load",             "load a scene from a file",                       params_load,        do_load)
CMD(load_obj,         "load_obj",         "load a single .obj object",                      params_load_obj,    do_load_obj)
CMD(list,             "list",             "list all registered commands",                   nullptr,            do_list)
